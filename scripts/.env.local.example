# 服务器密钥真值(不入库,仅本机部署用)
# 用法: 部署前 `set -a; source scripts/.env.local; set +a` 再跑 pm2/scp/ssh
# 服务器上的实际 PM2 配置在 /www/wwwroot/cbnac.com/ecosystem.config.cjs(真值,不入库)

# dsh-web
AUTH_SECRET=
GITHUB_TOKEN=
DSH_REGISTRY_HMAC=
SYNC_KEY=

# dsh-ws 与 dsh-web 共用
WS_GATEWAY_KEY=

# 服务器 root 密码(供 scp-put.sh / ssh-run.sh 使用)
DSH_SERVER_PASS=
