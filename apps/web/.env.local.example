# 本地开发环境变量(复制为 .env.local 并填写真值,不提交仓库)
# 生产环境由 PM2 注入(见 scripts/ecosystem.config.cjs)

# Auth.js 会话密钥(必填,生产用 openssl rand -hex 32 生成)
AUTH_SECRET=

# GitHub fine-grained PAT(插件商店同步用,授权 Contents 读)
GITHUB_TOKEN=

# dsh 插件注册表签名 HMAC 密钥
DSH_REGISTRY_HMAC=

# WS 网关共享密钥
WS_GATEWAY_KEY=

# 商店同步请求签名密钥
SYNC_KEY=

# 服务器地址(部署脚本用)
DSH_SERVER_HOST=47.98.207.149
